{
    "name": "@saolabs/builder",
    "version": "1.0.0",
    "description": "Saola Builder - builds .sao applications with the saola/compiler Composer package",
    "main": "src/index.js",
    "exports": {
        ".": "./src/index.js",
        "./vite": "./src/vite-plugin.js",
        "./webpack": "./src/webpack-plugin.js",
        "./package.json": "./package.json",
        "./dist": {
            "types": "./src/dist.d.ts",
            "default": "./src/dist.js"
        }
    },
    "files": [
        "src/",
        "docs/STANDALONE_DIST.md",
        "examples/standalone/"
    ],
    "type": "commonjs",
    "scripts": {
        "check": "npm ci --dry-run --ignore-scripts && npm audit && npm test && npm run check:pack",
        "test": "node src/test.js && node tests/test_typed_output.js && node tests/test_manifest_contract.js && node --test tests/dist.test.js tests/watcher.test.js",
        "check:pack": "npm pack --dry-run --ignore-scripts",
        "publish-dry-run": "npm publish --dry-run",
        "prepublishOnly": "npm test && echo 'Ready to publish @saolabs/builder'"
    },
    "keywords": [
        "saolabs",
        "saola builder",
        "builder",
        "blade",
        "javascript",
        "template"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saolabs/builder.git"
    },
    "author": "Sao Labs <saolaxoder@gmail.com>",
    "bugs": {
        "url": "https://github.com/saolabs/builder/issues"
    },
    "homepage": "https://github.com/saolabs/builder#readme",
    "publishConfig": {
        "access": "public"
    },
    "bin": {
        "sao-compile": "src/cli.js",
        "sao-build": "src/build-cli.js",
        "sao-dev": "src/dev-cli.js",
        "sao-dist": "src/dist-cli.js"
    },
    "directories": {
        "doc": "docs",
        "example": "examples"
    },
    "dependencies": {
        "chokidar": "^4.0.3",
        "dotenv": "^16.6.1",
        "dotenv-expand": "^12.0.3"
    }
}
